# Desarrollo local (make api). El front local (Vite) corre en el 5173.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
# El mismo VITE_CLIENT_ID del front.
GOOGLE_CLIENT_ID=

# Sin TABLA los datos quedan en memoria y se pierden al cortar la API.
# Para usar DynamoDB Local (ver README, "Tests"):
# TABLA=todo
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AWS_REGION=sa-east-1
