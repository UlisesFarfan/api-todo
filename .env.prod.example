# Copiar a .env.prod (no se commitea) y completar. Lo usa make deploy.
AWS_PROFILE=default
AWS_DEFAULT_REGION=sa-east-1
STACK_NAME=todo-api
# El front en Vercel, exacto y sin barra final. Varios, separados por coma.
ALLOWED_ORIGINS=https://todoappbyulises.vercel.app
# El mismo VITE_CLIENT_ID del front (Google Cloud > Credenciales > ID de cliente OAuth web).
GOOGLE_CLIENT_ID=
